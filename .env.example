# --- Supabase ---
# URL du projet Supabase (https://xxxx.supabase.co)
SUPABASE_URL=

# Clé publique (anon / publishable) — utilisée côté pages publiques, exposée au navigateur
SUPABASE_KEY=

# Clé service_role — SERVEUR UNIQUEMENT, ne jamais exposer côté client
SUPABASE_SERVICE_ROLE_KEY=

# --- Administration ---
# UUID de l'utilisateur Supabase autorisé à accéder à /admin et aux routes /api/*
ADMIN_USER_ID=

# --- Divers ---
# Endpoint du formulaire de contact (ex. https://formspree.io/f/xxxxxxx)
PUBLIC_CONTACT_FORM_ENDPOINT=
