---
import { supabase } from '../lib/supabase';
import Layout from '../layouts/Layout.astro';

const title = 'Actualités';
const description = 'Toutes les actualités';
const permalink = '/actualites';

const { data: allNews, error } = await supabase
  .from('news')
  .select('slug, title, description, publish_date')
  .order('publish_date', { ascending: false });

if (error) {
  console.error('Erreur Supabase:', error);
}
---

<Layout title={title} description={description} permalink={permalink}>
  <div class="container">
    <h1>Actualités</h1>
    <div class="news-grid">
      {allNews && allNews.map((post) => (
        <div class="news-card">
          <div class="news-card-header">
            <h2>
              <a href={`/actualites/${post.slug}`}>{post.title}</a>
            </h2>
            <span class="news-date">{new Date(post.publish_date).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          </div>
          <p class="news-description">{post.description}</p>
        </div>
      ))}
    </div>
  </div>
<style>
  .news-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: 2rem;
  }
  .news-card {
    background: #fff;
    border-radius: 1rem;
    box-shadow: 0 2px 16px rgba(0,0,0,0.08);
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.2s;
  }
  .news-card:hover {
    box-shadow: 0 4px 24px rgba(0,0,0,0.15);
  }
  .news-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    gap: 1rem;
  }
  .news-card h2 {
    font-size: 1.3rem;
    margin: 0;
    flex: 1;
  }
  .news-card a {
    color: var(--accent, #0077cc);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s;
  }
  .news-card a:hover {
    color: #005fa3;
    text-decoration: underline;
  }
  .news-date {
    font-size: 0.95rem;
    color: var(--text-secondary, #888);
    font-weight: 500;
    white-space: nowrap;
  }
  .news-description {
    margin: 0;
    color: var(--text-main, #222);
    font-size: 1.05rem;
  }
</style>
</Layout>