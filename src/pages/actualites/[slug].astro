---
import { supabase } from '../../lib/supabase';
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/actualites');
}

const { data: actualite, error } = await supabase
  .from('news')
  .select('*')
  .eq('slug', slug)
  .single();

if (error || !actualite) {
  console.error('Actualité non trouvée:', error);
  return Astro.redirect('/actualites');
}

const { title, description, content_html, publish_date } = actualite;
const permalink = `${Astro.site?.href ?? '/'}actualites/${slug}`;
---

<Layout title={title} description={description} permalink={permalink}>
  <header>
    <h1>{title}</h1>
    <p>{new Date(publish_date).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
    <hr />
  </header>
  <div class="container">
    <article class="content">
      <div set:html={content_html} />
    </article>
    <hr />
  </div>
</Layout>

<style>
  header {
    text-align: center;
  }
  header h1 {
    margin-bottom: 0.7em;
  }
  header p {
    color: var(--text-secondary);
    text-transform: uppercase;
    font-family: var(--font-family-sans);
    font-weight: 600;
  }
  header hr {
    min-width: 100px;
    width: 30%;
  }
</style>
